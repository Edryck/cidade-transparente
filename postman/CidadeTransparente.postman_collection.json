                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('corpo é ProblemDetail', () => pm.expect(pm.response.json().status).to.eql(401));",
                  "pm.test('mesma mensagem de e-mail inexistente', () => pm.expect(pm.response.json().detail).to.eql('E-mail ou senha inválidos'));"
                ]
              }
            }
