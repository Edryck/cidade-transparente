        {
          "name": "Registro de cidadão (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/registro-cidadao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "registro-cidadao"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"municipioId\": \"{{municipioDemoId}}\",\n  \"nome\": \"João Teste\",\n  \"email\": \"joao{{$timestamp}}@teste.com\",\n  \"senha\": \"senhaforte123\",\n  \"cpf\": \"{{cpfNovo}}\",\n  \"telefone\": \"41988887777\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// CPF válido e aleatório, para o registro poder rodar várias vezes sem conflito",
                  "const n = Array.from({length: 9}, () => Math.floor(Math.random() * 10));",
                  "const dv = a => { const r = (a.reduce((s, d, i) => s + d * (a.length + 1 - i), 0) * 10) % 11; return r === 10 ? 0 : r; };",
                  "n.push(dv(n)); n.push(dv(n));",
                  "pm.collectionVariables.set('cpfNovo', n.join(''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const corpo = pm.response.json();",
                  "const payload = JSON.parse(atob(corpo.token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "pm.test('já sai autenticado como CIDADAO', () => pm.expect(payload.roles).to.eql(['CIDADAO']));",
                  "pm.test('no município escolhido', () => pm.expect(payload.municipioId).to.eql(Number(pm.collectionVariables.get('municipioDemoId'))));",
                  "pm.collectionVariables.set('tokenCidadaoNovo', corpo.token);"
                ]
              }
            }
          ]
        },
