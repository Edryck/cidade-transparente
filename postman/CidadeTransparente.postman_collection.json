            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const payload = JSON.parse(atob(pm.response.json().token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "pm.test('roles = [ADMIN_PLATAFORMA]', () => pm.expect(payload.roles).to.eql(['ADMIN_PLATAFORMA']));",
                  "pm.test('token NÃO traz municipioId', () => pm.expect(payload).to.not.have.property('municipioId'));",
                  "pm.collectionVariables.set('tokenPlataforma', pm.response.json().token);"
