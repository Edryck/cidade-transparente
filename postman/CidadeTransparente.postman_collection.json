{
  "info": {
    "name": "Cidade Transparente",
    "description": "Testes de todos os endpoints da API. Rode a pasta Auth primeiro: cada login guarda o token do seu perfil em uma variável da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenOuvidor}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenPlataforma",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenOuvidor",
      "value": ""
    },
    {
      "key": "tokenServidor",
      "value": ""
    },
    {
      "key": "tokenCidadao",
      "value": ""
    },
    {
      "key": "tokenOuvidorOutro",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login ADMIN_PLATAFORMA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"plataforma@demo.gov.br\",\n  \"senha\": \"plataforma123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const payload = JSON.parse(atob(pm.response.json().token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "pm.test('roles = [ADMIN_PLATAFORMA]', () => pm.expect(payload.roles).to.eql(['ADMIN_PLATAFORMA']));",
                  "pm.test('token NÃO traz municipioId', () => pm.expect(payload).to.not.have.property('municipioId'));",
                  "pm.collectionVariables.set('tokenPlataforma', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
