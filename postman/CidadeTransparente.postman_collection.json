  "item": [
    {
      "name": "Municípios",
      "item": [
        {
          "name": "Listar municípios ativos (público)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/municipios/ativos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "municipios",
                "ativos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK sem token', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test('expõe só id, nome e uf', () => lista.forEach(m => pm.expect(m).to.have.all.keys('id','nome','uf')));",
                  "const demo = lista.find(m => m.nome === 'Vila Serena');",
                  "pm.test('contém o município de demo', () => pm.expect(demo).to.exist);",
                  "pm.collectionVariables.set('municipioDemoId', demo.id);"
                ]
              }
            }
          ]
        }
      ]
    },
